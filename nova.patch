 public class ExultActivity extends SDLActivity {
+    private NovaController nova;
+
+    @Override public boolean dispatchKeyEvent(android.view.KeyEvent event) {
+        if (nova != null && nova.key(event)) return true;
+        return super.dispatchKeyEvent(event);
+    }
+    @Override public boolean dispatchGenericMotionEvent(MotionEvent event) {
+        if (nova != null && nova.motion(event)) return true;
+        return super.dispatchGenericMotionEvent(event);
+    }
+    @Override public boolean dispatchTouchEvent(MotionEvent event) {
+        if (nova != null) nova.touch(event);
+        return super.dispatchTouchEvent(event);
+    }
+    @Override protected void onResume() {
+        super.onResume(); if (nova != null) nova.resume();
+    }
+    @Override protected void onPause() {
+        if (nova != null) nova.pause(); super.onPause();
+    }
+    @Override public void onWindowFocusChanged(boolean focused) {
+        if (nova != null) { if (focused) nova.resume(); else nova.pause(); }
+        super.onWindowFocusChanged(focused);
+    }
+    @Override protected void onDestroy() {
+        if (nova != null) nova.destroy(); super.onDestroy();
+    }
+
 	// Making this static for easy access from UI fragments, but it feels a bit
